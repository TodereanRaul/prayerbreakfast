# Supabase project (Project Settings → API). Without these the site runs in
# demo mode on the built-in list in src/data/seed.json and the admin is off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the site, used for link previews. Set it once the custom
# domain is live; until then the Vercel address is used automatically.
# NEXT_PUBLIC_SITE_URL=https://prayerbreakfasts.com
